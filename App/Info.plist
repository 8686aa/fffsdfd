<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>APP</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- SwiftUI 生命周期；UILaunchScreen 为空字典即可（iOS 14+ 要求） -->
    <key>UILaunchScreen</key>
    <dict/>
    <!--
      ⚠️ 这里必须把横屏也列上，即使主页只想竖屏。

      iOS 取「Info.plist 声明的方向」与「application(_:supportedInterface
      OrientationsFor:) 返回的 mask」的**交集**。只在 delegate 里返回横屏、
      plist 里不写 landscape，交集仍然是竖屏 —— 内置网页转不过来，而且
      不会有任何报错或日志，页面就是不动。

      实际的方向控制由 OrientationLock 负责：
        · 主页 → .portrait
        · 内置网页 → .allButUpsideDown（战术雷达那种页横屏才有意义）
    -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!--
      后台保活：iOS 没有 WakeLock，只有「音频后台模式」能让进程在后台常驻。
      App 里播的是一段 1 秒静音 WAV 循环（见 KeepAlive.swift），设置里可关。
      侧载（无签名 ipa）不受 App Store 审核限制；上架会被拒，这条要清楚。
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!--
      iOS 14+ 访问局域网要用户授权。没有这条描述，绑定/监听会被系统直接拒绝，
      表现是「扫码后连不上」而日志里什么都没有。
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>需要访问局域网，才能让同一 Wi-Fi 下的另一台设备连上本机的 SOCKS5 代理。</string>

    <!--
      节点接口与内置网页都是明文 http（约定端口 1082 / 666 / 8088），
      ATS 默认会拦掉。这里整体放开：目标地址全部由用户填写，且不涉及
      账号密码的持久化传输。
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
